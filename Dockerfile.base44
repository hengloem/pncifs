FROM php:7.4-apache

# Install mysqli extension
RUN docker-php-ext-install mysqli

# PHP 7.2+ removed session.hash_function/session.hash_bits_per_character.
# CI3's Session library validates the cookie against /^[0-9a-f]{40}$/ (SHA-1),
# but PHP 7.4 defaults to 32-char session IDs, so CI3 rejects its own cookie
# and starts a fresh empty session on every request. Force 40-char hex IDs.
RUN echo "session.sid_length = 40\nsession.sid_bits_per_character = 4" > /usr/local/etc/php/conf.d/session-sid.ini

# Enable Apache mod_rewrite for CodeIgniter URL routing
RUN a2enmod rewrite

# Ensure AllowOverride is set so .htaccess works (default image already has this,
# but we make it explicit)
RUN sed -i '/<Directory \/var\/www\/>/,/<\/Directory>/ s/AllowOverride None/AllowOverride All/' /etc/apache2/apache2.conf
